{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo/main.tsbuildinfo",
    "types": ["vitest/globals", "node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@orochi235/weasel": ["./src/index.ts"],
      "@orochi235/weasel/*": ["./src/*"],
      "@orochi235/weasel/routing": ["./src/tools/routing/index.ts"],
      "@orochi235/weasel-ui": ["./packages/weasel-ui/src/index.ts"],
      "@orochi235/weasel-svg": ["./packages/weasel-svg/src/index.ts"],
      "@orochi235/weasel-theme": ["./packages/weasel-theme/src/index.ts"],
      "@orochi235/weasel-theme/tokens.css": ["./packages/weasel-theme/src/tokens.css"],
      "core/*": ["./src/core/*"],
      "features/*": ["./src/features/*"],
      "affordances/*": ["./src/affordances/*"],
      "interactions/*": ["./src/interactions/*"],
      "tools/*": ["./src/tools/*"],
      "canvas/*": ["./src/canvas/*"]
    }
  },
  "include": ["src", "demo", "apps", "packages/weasel-ui/src", "packages/weasel-hud/src", "packages/weasel-theme/src", "packages/weasel-svg/src"],
  "exclude": ["node_modules", "dist"]
}
