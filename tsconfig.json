{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Every config that extends this one inherits `paths` into its siblings'
    // source. TS 6 would otherwise default `rootDir` to that config's own
    // directory and fail each of those files with TS6059.
    "rootDir": ".",
    "outDir": "./dist",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo/main.tsbuildinfo",
    "types": ["vitest/globals", "node", "@testing-library/jest-dom/vitest"],
    "ignoreDeprecations": "6.0",
