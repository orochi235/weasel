{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo/main.tsbuildinfo",
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@weasel-js/core": ["./src/index.ts"],
      "@weasel-js/core/*": ["./src/*"],
      "@weasel-js/core/routing": ["./src/tools/routing/index.ts"],
      "@weasel-js/ui": ["./packages/ui/src/index.ts"],
      "@weasel-js/svg": ["./packages/svg/src/index.ts"],
      "@weasel-js/geom": ["./packages/geom/src/index.ts"],
      "@weasel-js/geom/booleans": ["./packages/geom/src/booleans/index.ts"],
      "@weasel-js/geom/*": ["./packages/geom/src/*"],
      "@weasel-js/theme": ["./packages/theme/src/index.ts"],
      "@weasel-js/theme/tokens.css": ["./packages/theme/src/tokens.css"],
      "@weasel-js/gestures": ["./packages/gestures/src/index.ts"],
      "@weasel-js/history": ["./packages/history/src/index.ts"],
      "@weasel-js/modes": ["./packages/modes/src/index.ts"],
      "@weasel-js/modes/presets/default": ["./packages/modes/src/presets/default.ts"],
      "core/*": ["./src/core/*"],
      "features/*": ["./src/features/*"],
      "affordances/*": ["./src/affordances/*"],
      "interactions/*": ["./src/interactions/*"],
      "tools/*": ["./src/tools/*"],
      "canvas/*": ["./src/canvas/*"],
      "debug/*": ["./src/debug/*"]
    }
  },
  "include": ["src", "apps", "packages/ui/src", "packages/hud/src", "packages/theme/src", "packages/svg/src", "packages/geom/src", "packages/history/src", "packages/modes/src"],
  "exclude": ["node_modules", "dist"]
}
