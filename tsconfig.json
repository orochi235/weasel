{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo/main.tsbuildinfo",
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@weasel-js/core": ["./packages/core/src/index.ts"],
      // Subpaths resolve through the import-shim layer, mirroring both the
      // published `exports` map and scripts/vite-aliases.ts. Before core moved
      // into packages/, `@weasel-js/core/move` resolved by *package
      // self-reference* — the root package.json was core's, so tsc followed its
      // `exports` into the built `dist/`. That made typecheck silently depend
      // on a prior build; mapping to source removes that ordering hazard.
      "@weasel-js/core/*": ["./packages/core/src/import-shims/*"],
      // Every workspace referenced from apps/ or another package needs an entry
      // here. Unlike the vite aliases — which scripts/vite-aliases.ts generates
      // by reading packages/ at config-load time — this list is hand-maintained,
      // so a new workspace is easy to miss. A missing entry used to be harmless
      // (the package's `types` pointed at src, so node resolution found the
      // source anyway); now that they point at `dist`, a missing entry makes
      // `npm run typecheck` silently depend on a prior `npm run build`.
      "@weasel-js/ui": ["./packages/ui/src/index.ts"],
      "@weasel-js/svg": ["./packages/svg/src/index.ts"],
      "@weasel-js/d3": ["./packages/d3/src/index.ts"],
      "@weasel-js/hud": ["./packages/hud/src/index.ts"],
      "@weasel-js/hud/react": ["./packages/hud/src/react/index.ts"],
      "@weasel-js/geom": ["./packages/geom/src/index.ts"],
      "@weasel-js/geom/booleans": ["./packages/geom/src/booleans/index.ts"],
      "@weasel-js/geom/*": ["./packages/geom/src/*"],
      "@weasel-js/font": ["./packages/font/src/index.ts"],
      "@weasel-js/font/test-seams": ["./packages/font/src/test-seams.ts"],
      "@weasel-js/theme": ["./packages/theme/src/index.ts"],
      "@weasel-js/theme/react": ["./packages/theme/src/react.tsx"],
      "@weasel-js/theme/tokens.css": ["./packages/theme/src/generated/tokens.css"],
      "@weasel-js/gestures": ["./packages/gestures/src/index.ts"],
      "@weasel-js/history": ["./packages/history/src/index.ts"],
      "@weasel-js/modes": ["./packages/modes/src/index.ts"],
      "@weasel-js/modes/presets/default": ["./packages/modes/src/presets/default.ts"],
      "@weasel-js/labkit": ["./packages/labkit/src/index.ts"],
      // The two passthrough entries don't sit where their specifier says, so
      // they need explicit mappings ahead of the wildcard.
      "@weasel-js/labkit/weasel-ui": ["./packages/labkit/src/passthrough/weasel-ui.ts"],
      "@weasel-js/labkit/weasel-canvas": ["./packages/labkit/src/passthrough/weasel-canvas.ts"],
      "@weasel-js/labkit/*": ["./packages/labkit/src/*"],
      "core/*": ["./packages/core/src/core/*"],
      "features/*": ["./packages/core/src/features/*"],
      "affordances/*": ["./packages/core/src/affordances/*"],
      "interactions/*": ["./packages/core/src/interactions/*"],
      "tools/*": ["./packages/core/src/tools/*"],
      "canvas/*": ["./packages/core/src/canvas/*"],
      "debug/*": ["./packages/core/src/debug/*"]
    }
  },
  // `tests/bench` is in here and the rest of `tests/` is not: the benches
  // import kit internals through the path mappings above, so a rename in
  // core silently breaks them otherwise. The Playwright suites under
  // tests/e2e, tests/perf and tests/visual drive the app over a wire and
  // don't.
  "include": ["apps", "tests/bench", "packages/core/src", "packages/weasel-js/src", "packages/ui/src", "packages/hud/src", "packages/theme/src", "packages/svg/src", "packages/geom/src", "packages/font/src", "packages/history/src", "packages/modes/src", "packages/gestures/src", "packages/d3/src", "packages/labkit/src"],
  "exclude": ["node_modules", "dist"]
}
