{
  "name": "@weasel-js/core",
  "version": "0.4.0",
  "description": "Domain-agnostic 2D scene graph primitives for React: viewport math, drag/resize/insert/clone interactions, layered canvas rendering.",
  "license": "MIT",
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./move": {
      "import": "./dist/move.js",
      "types": "./dist/move.d.ts"
    },
    "./resize": {
      "import": "./dist/resize.js",
      "types": "./dist/resize.d.ts"
    },
    "./insert": {
      "import": "./dist/insert.js",
      "types": "./dist/insert.d.ts"
    },
    "./clipboard": {
      "import": "./dist/clipboard.js",
      "types": "./dist/clipboard.d.ts"
    },
    "./clone": {
      "import": "./dist/clone.js",
      "types": "./dist/clone.d.ts"
    },
    "./patterns-builtin": {
      "import": "./dist/patterns-builtin.js",
      "types": "./dist/patterns-builtin.d.ts"
    },
    "./renderer": {
      "import": "./dist/renderer.js",
      "types": "./dist/renderer.d.ts"
    },
    "./routing": {
      "import": "./dist/routing.js",
      "types": "./dist/routing.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "concurrently -n kit,draw,storybook -c green,blue,magenta \"npm:dev:kit\" \"npm:dev:draw\" \"npm:dev:storybook\"",
    "dev:kit": "vite",
    "dev:draw": "vite --config apps/draw/vite.config.ts",
    "dev:storybook": "storybook dev -p 6010 --no-open",
    "build": "tsup",
    "build:demo": "vite build && npm run build:api",
    "build:draw": "vite build --config apps/draw/vite.config.ts",
    "build:api": "typedoc && npm run build:api:gestures",
    "build:api:gestures": "typedoc --options packages/gestures/typedoc.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=kit --project=weasel-ui --project=draw --project=labkit --project=smoke",
    "test:unit": "vitest run --project=kit --project=weasel-ui --project=draw --project=labkit",
    "test:kit": "vitest run --project=kit",
    "test:ui": "vitest run --project=weasel-ui",
    "test:draw": "vitest run --project=draw",
    "test:smoke": "vitest run --project=smoke",
    "test:smoke:consumer": "node scripts/smoke-consumer-bundle.mjs",
    "test:stories": "vitest run --project=storybook",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:visual": "playwright test --config=tests/visual/playwright.config.ts",
    "test:visual:update": "UPDATE_SNAPSHOTS=1 playwright test --config=tests/visual/playwright.config.ts",
    "test:e2e:draw": "playwright test --config=apps/draw/tests-e2e/playwright.config.ts",
    "test:e2e:demos": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:perf": "playwright test --config=tests/perf/playwright.config.ts",
    "lint": "tsc --noEmit",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run test:smoke:consumer && npm run build:demo",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@fontsource/inter": "5.0.20",
    "@playwright/test": "1.47.2",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-themes": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/earcut": "2.1.4",
    "@types/node": "^24.12.2",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.6",
    "concurrently": "^9.2.1",
    "d3-force": "^3.0.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^26.1.0",
    "msdf-bmfont-xml": "2.8.0",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.3.6",
    "ts-morph": "^28.0.0",
    "tsup": "^8.3.0",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "canvas",
    "scene-graph",
    "drag",
    "resize",
    "viewport",
    "2d"
  ],
  "dependencies": {
    "@weasel-js/gestures": "*",
    "@weasel-js/history": "*",
    "@weasel-js/modes": "*",
    "earcut": "2.2.4",
    "polygon-clipping": "^0.15.7"
  },
  "workspaces": [
    "packages/*"
  ]
}
