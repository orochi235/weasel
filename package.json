{
  "name": "weasel",
  "private": true,
  "version": "0.4.0",
  "description": "Monorepo root for the weasel canvas kit. Not published — the workspaces under packages/ are. See packages/core for @weasel-js/core.",
  "license": "MIT",
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n kit,draw,storybook -c green,blue,magenta \"npm:dev:kit\" \"npm:dev:draw\" \"npm:dev:storybook\"",
    "dev:kit": "vite",
    "dev:draw": "vite --config apps/draw/vite.config.ts",
    "dev:storybook": "storybook dev -p 6010 --no-open",
    "build": "npm run build:leaves && npm run build:core && npm run build:downstream",
    "build:leaves": "npm run build -w @weasel-js/geom -w @weasel-js/gestures -w @weasel-js/history -w @weasel-js/modes -w @weasel-js/theme -w @weasel-js/paint -w @weasel-js/font -w @weasel-js/text -w @weasel-js/audio",
    "build:core": "npm run build -w @weasel-js/core",
    "build:downstream": "npm run build -w @weasel-js/svg -w @weasel-js/d3 -w @weasel-js/ui -w @weasel-js/hud -w weasel-js -w @weasel-js/labkit",
    "build:demo": "vite build && npm run build:api",
    "build:draw": "vite build --config apps/draw/vite.config.ts",
    "build:api": "typedoc && npm run build:api:gestures",
    "build:api:gestures": "typedoc --options packages/gestures/typedoc.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=kit --project=weasel-ui --project=draw --project=labkit --project=smoke",
    "test:unit": "vitest run --project=kit --project=weasel-ui --project=draw --project=labkit",
    "test:kit": "vitest run --project=kit",
    "test:ui": "vitest run --project=weasel-ui",
    "test:draw": "vitest run --project=draw",
    "test:smoke": "vitest run --project=smoke",
    "test:smoke:consumer": "node scripts/smoke-consumer-bundle.mjs",
    "check:manifests": "node scripts/check-publish-manifests.mjs",
    "check:bumps": "node scripts/check-changeset-bumps.mjs",
    "check:frame-loops": "node scripts/check-frame-loops.mjs",
    "audit:jsdoc": "node scripts/audit-jsdoc.mjs",
    "gen:font": "node packages/font/scripts/gen-font.ts",
    "test:stories": "vitest run --project=storybook",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:visual": "playwright test --config=tests/visual/playwright.config.ts",
    "test:visual:update": "UPDATE_SNAPSHOTS=1 playwright test --config=tests/visual/playwright.config.ts",
    "test:e2e:draw": "playwright test --config=apps/draw/tests-e2e/playwright.config.ts",
    "test:e2e:demos": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:perf": "playwright test --config=tests/perf/playwright.config.ts",
    "bench": "vitest bench --run --config vitest.bench.config.ts --compare tests/bench/results/baseline.json",
    "bench:baseline": "vitest bench --run --config vitest.bench.config.ts --outputJson tests/bench/results/baseline.json && node scripts/bench-report.mjs",
    "lint": "eslint packages apps",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "npm run check:bumps && npm run typecheck && npm run lint && npm run test && npm run test:stories && npm run build && npm run check:manifests && npm run test:smoke:consumer",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen:icons": "node packages/ui/scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@fontsource/inter": "5.0.20",
    "@playwright/test": "1.47.2",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-themes": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/earcut": "2.1.4",
    "@types/node": "^24.12.2",
    "@types/opentype.js": "1.3.10",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.6",
    "concurrently": "^9.2.1",
    "d3-force": "^3.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "marked": "^18.0.10",
    "msdf-bmfont-xml": "2.8.0",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.3.6",
    "ts-morph": "^28.0.0",
    "tsup": "^8.3.0",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
