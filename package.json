{
  "name": "weasel",
  "private": true,
  "version": "0.4.0",
  "description": "Monorepo root for the weasel canvas kit. Not published \u2014 the workspaces under packages/ are. See packages/core for @weasel-js/core.",
  "license": "MIT",
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n kit,draw,forge -c green,blue,yellow \"npm:dev:kit\" \"npm:dev:draw\" \"npm:dev:forge\"",
    "dev:kit": "vite",
    "dev:draw": "vite --config apps/draw/vite.config.ts",
    "dev:forge": "vite --config apps/forge/vite.config.ts",
    "dev:theme-editor": "vite --config apps/theme-editor/vite.config.ts",
    "build": "npm run build:leaves && npm run build:core && npm run build:downstream",
    "build:leaves": "npm run build -w @weasel-js/geom -w @weasel-js/gestures -w @weasel-js/history -w @weasel-js/modes -w @weasel-js/paint -w @weasel-js/theme -w @weasel-js/font -w @weasel-js/bidi -w @weasel-js/text -w @weasel-js/audio -w @weasel-js/cursor -w @weasel-js/routing",
    "build:core": "npm run build -w @weasel-js/core",
    "build:downstream": "npm run build -w @weasel-js/loupe -w @weasel-js/svg -w @weasel-js/d3 -w @weasel-js/diagram -w @weasel-js/kernel3d -w @weasel-js/ui -w @weasel-js/hud -w @weasel-js/labkit -w @weasel-js/forge",
    "build:demo": "vite build && npm run build:api",
    "build:draw": "vite build --config apps/draw/vite.config.ts",
    "build:forge": "vite build --config apps/forge/vite.config.ts",
    "build:theme-editor": "vite build --config apps/theme-editor/vite.config.ts",
    "build:api": "typedoc && npm run build:api:gestures",
    "build:api:gestures": "typedoc --options packages/gestures/typedoc.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=core --project=site --project=weasel-ui --project=draw --project=labkit --project=forge --project=smoke",
    "test:unit": "vitest run --project=core --project=site --project=weasel-ui --project=draw --project=labkit --project=forge",
    "test:core": "vitest run --project=core",
    "test:ui": "vitest run --project=weasel-ui",
    "test:draw": "vitest run --project=draw",
    "test:smoke": "vitest run --project=smoke",
    "test:smoke:consumer": "node scripts/smoke-consumer-bundle.mjs",
    "check:first-publish": "node scripts/check-first-publish.mjs",
    "check:manifests": "node scripts/check-publish-manifests.mjs",
    "check:react-free": "node scripts/check-react-free.mjs",
    "check:published": "node scripts/check-published-versions.mjs",
    "test:smoke:registry": "node scripts/smoke-registry-install.mjs",
    "check:bumps": "node scripts/check-changeset-bumps.mjs",
    "check:lockstep": "node scripts/check-lockstep.mjs",
    "check:frame-loops": "node scripts/check-frame-loops.mjs",
    "check:token-reads": "tsx scripts/check-token-reads.ts",
    "check:spacing": "tsx scripts/check-spacing.ts",
    "check:controls": "tsx scripts/check-controls.ts",
    "check:labels": "tsx scripts/check-labels.ts",
    "check:test-projects": "node scripts/check-test-projects.mjs",
    "check:forge-boundary": "node scripts/check-forge-boundary.mjs",
    "check:forge-stories": "node packages/forge/scripts/check-stories.ts",
    "audit:jsdoc": "node scripts/audit-jsdoc.mjs",
    "gen:bidi-tables": "node packages/bidi/scripts/gen-bidi-tables.mjs",
    "gen:font": "node packages/font/scripts/gen-font.ts",
    "test:stories:forge": "vitest run --project=forge-stories",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:visual": "playwright test --config=tests/visual/playwright.config.ts",
    "test:visual:update": "UPDATE_SNAPSHOTS=1 playwright test --config=tests/visual/playwright.config.ts",
    "test:e2e:draw": "playwright test --config=apps/draw/tests-e2e/playwright.config.ts",
    "test:e2e:demos": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:perf": "playwright test --config=tests/perf/playwright.config.ts",
    "perf:bench": "node tests/perf/bench.mjs",
    "perf:bench:baseline": "vitest bench --run --config tests/perf/vitest.bench.config.ts --outputJson tests/perf/bench/baseline.json && node tests/perf/bench-report.mjs",
    "perf:compare": "node tests/perf/compare.mjs",
    "lint": "eslint packages apps",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "npm run check:bumps && npm run check:test-projects && npm run typecheck && npm run lint && npm run test && npm run test:stories:forge && npm run build && npm run check:manifests && npm run test:smoke:consumer",
    "prepare": "npm run build",
    "gen:icons": "node packages/ui/scripts/gen-icons.mjs",
    "gen:panel-stances": "tsx packages/ui/scripts/gen-panel-stances.ts",
    "gen:cursors": "node packages/cursor/scripts/gen-cursors.mjs",
    "proof:cursors": "node --import ./packages/cursor/scripts/ts-resolve.mjs packages/cursor/scripts/proof-cursors.mjs",
    "proof:pixels": "node --import ./packages/cursor/scripts/ts-resolve.mjs packages/cursor/scripts/proof-pixels.mjs",
    "proof:painted": "node --import ./packages/cursor/scripts/ts-resolve.mjs packages/cursor/scripts/proof-painted.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@fontsource/inter": "5.0.20",
    "@playwright/test": "1.47.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/earcut": "2.1.4",
    "@types/node": "^24.12.2",
    "@types/opentype.js": "1.3.10",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.6",
    "concurrently": "^9.2.1",
    "d3-force": "^3.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "marked": "^18.0.10",
    "msdf-bmfont-xml": "2.8.0",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ts-morph": "^28.0.0",
    "tsup": "^8.3.0",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
