{
  "name": "@weasel-js/devtools",
  "version": "2.0.0",
  "description": "A devtools panel for weasel canvases, and the hook a page installs for it: each canvas's scene tree, state, dispatch trace and frame stats, read and steered over the hook's protocol.",
  "weasel": {
    "tier": "plugin"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "import": "./dist/hook.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.mjs dist",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/gestures": "2.0.0",
    "@weasel-js/history": "2.0.0",
    "@weasel-js/icons": "2.0.0",
    "@weasel-js/react": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "@weasel-js/routing": "2.0.0",
    "@weasel-js/ui": "2.0.0"
  },
  "peerDependencies": {
    "@weasel-js/core": "2.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@weasel-js/editing": "2.0.0"
  }
}
