{
  // Core's own build/typecheck config. The repo-root tsconfig.json remains the
  // solution-wide config (apps + every package) used by `npm run typecheck`;
  // this one exists so `tsup` — which reads tsconfig.json from its cwd — and
  // `tsc --noEmit -p .` see core in isolation.
  //
  // `paths` is declared in full rather than inherited via `extends`, because
  // path mappings resolve relative to the config file that declares them and
  // this file sits two levels below the root.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "tsBuildInfoFile": "../../.tsbuildinfo/core.tsbuildinfo",
    "noEmit": true,
    "paths": {
      // Generated by `npm run gen:tsconfig-paths` from every package's `exports`; do not edit.
      "@weasel-js/core": ["./src/index.ts"],
      "@weasel-js/core/math": ["./src/import-shims/math.ts"],
      "@weasel-js/core/mesh": ["./src/import-shims/mesh.ts"],
      "@weasel-js/core/move": ["./src/import-shims/move.ts"],
      "@weasel-js/core/resize": ["./src/import-shims/resize.ts"],
      "@weasel-js/core/clipboard": ["./src/import-shims/clipboard.ts"],
      "@weasel-js/core/clone": ["./src/import-shims/clone.ts"],
      "@weasel-js/core/patterns-builtin": ["./src/import-shims/patterns-builtin.ts"],
      "@weasel-js/core/renderer": ["./src/import-shims/renderer.ts"],
      "@weasel-js/core/routing": ["./src/import-shims/routing.ts"],
      "@weasel-js/core/test-seams": ["./src/import-shims/test-seams.ts"],
      "@weasel-js/geom": ["../geom/src/index.ts"],
      "@weasel-js/geom/booleans": ["../geom/src/booleans/index.ts"],
      "@weasel-js/geom/3d": ["../geom/src/3d/index.ts"],
      "@weasel-js/geom/nd": ["../geom/src/nd/index.ts"],
      "@weasel-js/geom/curves": ["../geom/src/curves/index.ts"],
      "@weasel-js/geom/tessellate": ["../geom/src/tessellate/index.ts"],
      "@weasel-js/gestures": ["../gestures/src/index.ts"],
      "@weasel-js/history": ["../history/src/index.ts"],
      "@weasel-js/modes": ["../modes/src/index.ts"],
      "@weasel-js/modes/presets/default": ["../modes/src/presets/default.ts"],
      "@weasel-js/react": ["../react/src/index.ts"],
      "@weasel-js/react/testing/*": ["../react/src/testing/*"],
      "@weasel-js/registry": ["../registry/src/index.ts"],
      "@weasel-js/routing": ["../routing/src/index.ts"],
      "@weasel-js/routing/react": ["../routing/src/react.ts"],
      "@weasel-js/routing/internal": ["../routing/src/internal.ts"],
      "@weasel-js/select": ["../select/src/index.ts"],
      "@weasel-js/simulation": ["../simulation/src/index.ts"],
      "@weasel-js/simulation/react": ["../simulation/src/react.ts"],
      "@weasel-js/svg": ["../svg/src/index.ts"],
      "@weasel-js/svg/testing/*": ["../svg/src/testing/*"],
      "core/*": ["./src/core/*"],
      "features/*": ["./src/features/*"],
      "affordances/*": ["./src/affordances/*"],
      "interactions/*": ["./src/interactions/*"],
      "tools/*": ["./src/tools/*"],
      "canvas/*": ["./src/canvas/*"],
      "debug/*": ["./src/debug/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
