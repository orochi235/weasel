{
  // Core's own build/typecheck config. The repo-root tsconfig.json remains the
  // solution-wide config (apps + every package) used by `npm run typecheck`;
  // this one exists so `tsup` — which reads tsconfig.json from its cwd — and
  // `tsc --noEmit -p .` see core in isolation.
  //
  // `paths` is declared in full rather than inherited via `extends`, because
  // tsup's declaration build resolves inherited mappings against this
  // directory, not the root's.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The root sets `rootDir` for every other package. tsup's declaration
    // build resolves an inherited one against this directory, as it does
    // `paths`, and then fails on each sibling's source with TS6059.
    "rootDir": "../..",
    "outDir": "./dist",
    "tsBuildInfoFile": "../../.tsbuildinfo/core.tsbuildinfo",
    "noEmit": true,
    "paths": {
      // Generated by `npm run gen:tsconfig-paths` from every package's `exports`; do not edit.
      "@weasel-js/animator": ["../animator/src/index.ts"],
