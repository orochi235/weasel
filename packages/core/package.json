{
  "name": "@weasel-js/core",
  "version": "2.0.0",
  "description": "A 2D scene-graph engine for React, rendered on WebGL2: the scene tree, viewport math, pointer and keyboard input, layered rendering, and op-based undo.",
  "weasel": {
    "tier": "core",
    "needs": [
      "webgl2"
    ]
  },
  "license": "MIT",
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/import-shims/mesh.ts",
    "./dist/mesh.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    },
    "./mesh": {
      "types": "./dist/mesh.d.ts",
      "import": "./dist/mesh.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./patterns-builtin": {
      "types": "./dist/patterns-builtin.d.ts",
      "import": "./dist/patterns-builtin.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "import": "./dist/routing.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./groups": {
      "types": "./dist/groups.d.ts",
      "import": "./dist/groups.js"
    },
    "./ops": {
      "types": "./dist/ops.d.ts",
      "import": "./dist/ops.js"
    },
    "./render-worker": {
      "types": "./dist/render-worker.d.ts",
      "import": "./dist/render-worker.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./test-seams": {
      "types": "./dist/test-seams.d.ts",
      "import": "./dist/test-seams.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node ../../scripts/package-test.mjs",
    "build": "vite build && tsup && cp src/icons.table.json dist/ && node ../labkit/scripts/build-css.mjs --if-built",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@msb235/blits": "^1.1.0",
    "@weasel-js/font": "2.0.0",
    "react": ">=18"
  },
  "dependencies": {
    "@weasel-js/animator": "2.0.0",
    "@weasel-js/cursor": "2.0.0",
    "@weasel-js/geom": "2.0.0",
    "@weasel-js/gestures": "2.0.0",
    "@weasel-js/history": "2.0.0",
    "@weasel-js/icons": "2.0.0",
    "@weasel-js/modes": "2.0.0",
    "@weasel-js/paint": "2.0.0",
    "@weasel-js/paint-kinds": "2.0.0",
    "@weasel-js/prefs-schema": "2.0.0",
    "@weasel-js/quantity": "2.0.0",
    "@weasel-js/react": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "@weasel-js/renderer": "2.0.0",
    "@weasel-js/routing": "2.0.0",
    "@weasel-js/select": "2.0.0",
    "@weasel-js/stroke": "2.0.0",
    "earcut": "3.2.4",
    "polygon-clipping": "^0.15.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "react",
    "canvas",
    "scene-graph",
    "drag",
    "resize",
    "viewport",
    "2d"
  ],
  "devDependencies": {
    "@msb235/blits": "1.4.0",
    "@weasel-js/icons-plugin": "2.0.0",
    "@weasel-js/modes": "2.0.0",
    "@weasel-js/text": "2.0.0",
    "@weasel-js/text-dom": "2.0.0",
    "@weasel-js/theme": "2.0.0"
  }
}
