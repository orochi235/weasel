{
  "name": "@weasel-js/core",
  "version": "1.13.0",
  "description": "A 2D scene-graph engine for React, rendered on WebGL2: the scene tree, viewport math, pointer and keyboard input, layered rendering, and op-based undo.",
  "weasel": {
    "needs": ["webgl2"]
  },
  "license": "MIT",
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/import-shims/mesh.ts",
    "./src/import-shims/devtools.ts",
    "./dist/devtools.js",
    "./src/core/paint/registerMesh.ts",
    "./dist/mesh.js",
    "./dist/core/paint/registerMesh.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./icons": {
      "import": "./dist/icons.js",
      "types": "./dist/icons.d.ts"
    },
    "./math": {
      "import": "./dist/math.js",
      "types": "./dist/math.d.ts"
    },
    "./mesh": {
      "import": "./dist/mesh.js",
      "types": "./dist/mesh.d.ts"
    },
    "./move": {
      "import": "./dist/move.js",
      "types": "./dist/move.d.ts"
    },
    "./resize": {
      "import": "./dist/resize.js",
      "types": "./dist/resize.d.ts"
    },
    "./clipboard": {
      "import": "./dist/clipboard.js",
      "types": "./dist/clipboard.d.ts"
    },
    "./clone": {
      "import": "./dist/clone.js",
      "types": "./dist/clone.d.ts"
    },
    "./json": {
      "import": "./dist/json.js",
      "types": "./dist/json.d.ts"
    },
    "./devtools": {
      "import": "./dist/devtools.js",
      "types": "./dist/devtools.d.ts"
    },
    "./devtools-protocol": {
      "import": "./dist/devtools-protocol.js",
      "types": "./dist/devtools-protocol.d.ts"
    },
    "./patterns-builtin": {
      "import": "./dist/patterns-builtin.js",
      "types": "./dist/patterns-builtin.d.ts"
    },
    "./renderer": {
      "import": "./dist/renderer.js",
      "types": "./dist/renderer.d.ts"
    },
    "./routing": {
      "import": "./dist/routing.js",
      "types": "./dist/routing.d.ts"
    },
    "./test-seams": {
      "import": "./dist/test-seams.js",
      "types": "./dist/test-seams.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsup && cp src/icons.table.json dist/ && node ../labkit/scripts/build-css.mjs --if-built",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@weasel-js/font": "1.13.0",
    "react": ">=18"
  },
  "dependencies": {
    "@msb235/blits": "0.12.0",
    "@weasel-js/animator": "1.13.0",
    "@weasel-js/cursor": "1.13.0",
    "@weasel-js/geom": "1.13.0",
    "@weasel-js/gestures": "1.13.0",
    "@weasel-js/history": "1.13.0",
    "@weasel-js/icons": "1.13.0",
    "@weasel-js/modes": "1.13.0",
    "@weasel-js/paint": "1.13.0",
    "@weasel-js/prefs": "1.13.0",
    "@weasel-js/quantity": "1.13.0",
    "@weasel-js/react": "1.13.0",
    "@weasel-js/registry": "1.13.0",
    "@weasel-js/renderer": "1.13.0",
    "@weasel-js/routing": "1.13.0",
    "@weasel-js/select": "1.13.0",
    "@weasel-js/simulation": "1.13.0",
    "@weasel-js/stroke": "1.13.0",
    "@weasel-js/text": "1.13.0",
    "@weasel-js/text-dom": "1.13.0",
    "earcut": "3.2.3",
    "polygon-clipping": "^0.15.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "react",
    "canvas",
    "scene-graph",
    "drag",
    "resize",
    "viewport",
    "2d"
  ],
  "devDependencies": {
    "@weasel-js/icons-plugin": "1.13.0",
    "@weasel-js/modes": "1.13.0",
    "@weasel-js/theme": "1.13.0"
  }
}
