{
  "name": "@weasel-js/core",
  "version": "1.19.1",
  "description": "A 2D scene-graph engine for React, rendered on WebGL2: the scene tree, viewport math, pointer and keyboard input, layered rendering, and op-based undo.",
  "weasel": {
    "tier": "core",
    "needs": ["webgl2"]
  },
  "license": "MIT",
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/import-shims/mesh.ts",
    "./src/import-shims/devtools.ts",
    "./dist/devtools.js",
    "./src/core/paint/registerMesh.ts",
    "./dist/mesh.js",
    "./dist/core/paint/registerMesh.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    },
    "./mesh": {
      "types": "./dist/mesh.d.ts",
      "import": "./dist/mesh.js"
    },
    "./move": {
      "types": "./dist/move.d.ts",
      "import": "./dist/move.js"
    },
    "./resize": {
      "types": "./dist/resize.d.ts",
      "import": "./dist/resize.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "import": "./dist/clipboard.js"
    },
    "./clone": {
      "types": "./dist/clone.d.ts",
      "import": "./dist/clone.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./devtools-protocol": {
      "types": "./dist/devtools-protocol.d.ts",
      "import": "./dist/devtools-protocol.js"
    },
    "./patterns-builtin": {
      "types": "./dist/patterns-builtin.d.ts",
      "import": "./dist/patterns-builtin.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "import": "./dist/routing.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./render-worker": {
      "types": "./dist/render-worker.d.ts",
      "import": "./dist/render-worker.js"
    },
    "./named-features": {
      "types": "./dist/named-features.d.ts",
      "import": "./dist/named-features.js"
    },
    "./test-seams": {
      "types": "./dist/test-seams.d.ts",
      "import": "./dist/test-seams.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node ../../scripts/package-test.mjs",
    "build": "vite build && tsup && cp src/icons.table.json dist/ && node ../labkit/scripts/build-css.mjs --if-built",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@msb235/blits": "^1.1.0",
    "@weasel-js/font": "1.19.1",
    "react": ">=18"
  },
  "dependencies": {
    "@weasel-js/animator": "1.19.1",
    "@weasel-js/cursor": "1.19.1",
    "@weasel-js/geom": "1.19.1",
    "@weasel-js/gestures": "1.19.1",
    "@weasel-js/history": "1.19.1",
    "@weasel-js/icons": "1.19.1",
    "@weasel-js/modes": "1.19.1",
    "@weasel-js/paint": "1.19.1",
    "@weasel-js/prefs": "1.19.1",
    "@weasel-js/quantity": "1.19.1",
    "@weasel-js/react": "1.19.1",
    "@weasel-js/registry": "1.19.1",
    "@weasel-js/renderer": "1.19.1",
    "@weasel-js/routing": "1.19.1",
    "@weasel-js/select": "1.19.1",
    "@weasel-js/simulation": "1.19.1",
    "@weasel-js/stroke": "1.19.1",
    "@weasel-js/ui-input": "1.19.1",
    "earcut": "3.2.4",
    "polygon-clipping": "^0.15.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "react",
    "canvas",
    "scene-graph",
    "drag",
    "resize",
    "viewport",
    "2d"
  ],
  "devDependencies": {
    "@msb235/blits": "1.2.0",
    "@weasel-js/icons-plugin": "1.19.1",
    "@weasel-js/modes": "1.19.1",
    "@weasel-js/text": "1.19.1",
    "@weasel-js/text-dom": "1.19.1",
    "@weasel-js/theme": "1.19.1"
  }
}
