{
  "name": "@weasel-js/editing",
  "version": "2.0.0",
  "description": "Editing for a weasel canvas, as presets an app opts into: selecting, moving, resizing and rotating, the edit, arrange and Pathfinder commands, and paste and drop.",
  "weasel": {
    "tier": "plugin"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./groups": {
      "types": "./dist/groups.d.ts",
      "import": "./dist/groups.js"
    },
    "./test-seams": {
      "types": "./dist/test-seams.d.ts",
      "import": "./dist/test-seams.js"
    },
    "./icons": {
      "types": "./dist/icons.table.d.ts",
      "import": "./dist/icons.table.js"
    },
    "./package.json": "./package.json"
  },
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/editing"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsup && cp src/icons.table.json dist/",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/cursor": "2.0.0",
    "@weasel-js/gestures": "2.0.0",
    "@weasel-js/icons": "2.0.0",
    "@weasel-js/paint": "2.0.0",
    "@weasel-js/prefs-schema": "2.0.0",
    "@weasel-js/react": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "@weasel-js/renderer": "2.0.0",
    "@weasel-js/routing": "2.0.0",
    "@weasel-js/select": "2.0.0",
    "@weasel-js/stroke": "2.0.0",
    "polygon-clipping": "^0.15.7"
  },
  "peerDependencies": {
    "@weasel-js/core": "2.0.0",
    "@weasel-js/geom": "2.0.0",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
