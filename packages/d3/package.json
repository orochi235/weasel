{
  "name": "@weasel-js/d3",
  "version": "0.0.0",
  "private": true,
  "description": "d3 bridge for weasel: data-join + transition chain over useScene and useAnimator. d3-force already integrates via useSimulation in the main kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "d3-force": { "optional": true },
    "d3-ease": { "optional": true }
  },
  "dependencies": {
    "d3-interpolate": "^3.0.1"
  }
}
