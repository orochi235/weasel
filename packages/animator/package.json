{
  "name": "@weasel-js/animator",
  "version": "1.19.1",
  "description": "The weasel animator: tweens, springs, holds, staggers, and timelines that combine on targets, run by one frame loop. Needs no scene; the root entry has no React, and the hook is under /react.",
  "weasel": {
    "tier": "base"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./package.json": "./package.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/animator"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node ../../scripts/package-test.mjs",
    "build": "tsup"
  },
  "dependencies": {
    "@weasel-js/clock": "1.19.1",
    "@weasel-js/geom": "1.19.1",
    "@weasel-js/paint": "1.19.1",
    "@weasel-js/react": "1.19.1",
    "@weasel-js/registry": "1.19.1"
  },
  "peerDependencies": {
    "@msb235/blits": "^1.1.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@msb235/blits": "1.2.0"
  }
}
