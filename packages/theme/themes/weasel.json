        "ref": "gray-900",
        "type": "color"
      },
      "light": {
        "ref": "gray-200",
        "type": "color"
      }
    },
    "fg": {
      "by": "mode",
      "dark": {
        "ref": "gray-100",
        "type": "color"
      },
      "light": {
        "ref": "gray-900",
        "type": "color"
      }
    },
    "fg-muted": {
      "by": "mode",
      "dark": {
        "ref": "gray-300",
        "type": "color"
      },
      "light": {
        "ref": "gray-600",
        "type": "color"
      }
    },
    "fg-subtle": {
      "by": "mode",
      "dark": {
        "ref": "gray-400",
        "type": "color"
      },
      "light": {
        "ref": "gray-500",
        "type": "color"
      }
    },
    "border": {
      "by": "mode",
      "dark": {
        "ref": "gray-700",
        "type": "color"
      },
      "light": {
        "ref": "gray-200",
        "type": "color"
      }
    },
    "border-strong": {
      "by": "mode",
      "dark": {
        "ref": "gray-400",
        "type": "color",
        "description": "The line that has to be seen: a control's edge, a raised surface's outline. Clears WCAG 1.4.11's 3:1 against every surface in both modes."
      },
      "light": {
        "ref": "gray-500",
        "type": "color"
      }
    },
    "accent-fg": {
      "by": "mode",
      "dark": {
        "ref": "accent-strong",
        "type": "color",
        "description": "Accent for foreground use — text, icons, selected labels drawn on a surface. accent is a fill; the midnight base is too dim to read as text on dark surfaces."
      },
      "light": {
        "ref": "accent-base",
        "type": "color",
        "description": "Flips to the deep base in light mode, where it is the legible one."
      }
    },
    "secondary-fg": {
      "ramp": "secondary",
      "contrast": {
        "min": 4.5,
        "against": [
          "surface"
        ]
      },
      "description": "Secondary accent for foreground use: a second voice beside the accent, such as a value the panel derived rather than one the user set. Picked from the ramp so it clears 4.5:1 on the surface in both modes."
    },
    "fg-inverse": {
      "by": "mode",
      "dark": {
        "ref": "gray-900",
        "type": "color",
        "description": "Text drawn on a filled foreground-colored element (e.g. a slider thumb). Flips with the mode, so it is a semantic, not an alias to a primitive."
      },
      "light": {
        "ref": "gray-50",
        "type": "color",
        "description": "Flips with the mode — see the dark layer."
      }
    },
    "shadow": {
      "by": "mode",
      "dark": {
        "value": "rgba(0, 0, 0, 0.6)",
        "type": "color",
        "description": "Elevation. Always darker than any surface — never derived from fg, which is near-white on dark."
      },
      "light": {
        "value": "rgba(0, 0, 0, 0.18)",
        "type": "color"
      }
    }
  },
