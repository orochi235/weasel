{
  "name": "@weasel-js/geom",
  "version": "1.7.2",
  "description": "Pure geometry kernel for @weasel-js/core: affine, box, curve, polyline, the Path command stream and its math, and easing curves in 2D. Dependency-free core; curve representations in ./curves, tessellation in ./tessellate (earcut), polygon booleans and path splitting in ./booleans (polygon-clipping), vectors, quaternions, 4x4 matrices and ray intersection in ./3d.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./booleans": {
      "import": "./dist/booleans/index.js",
      "types": "./dist/booleans/index.d.ts"
    },
    "./3d": {
      "import": "./dist/3d/index.js",
      "types": "./dist/3d/index.d.ts"
    },
    "./curves": {
      "import": "./dist/curves/index.js",
      "types": "./dist/curves/index.d.ts"
    },
    "./tessellate": {
      "import": "./dist/tessellate/index.js",
      "types": "./dist/tessellate/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "earcut": "3.2.3",
    "polygon-clipping": "^0.15.7"
  },
  "peerDependenciesMeta": {
    "earcut": {
      "optional": true
    },
    "polygon-clipping": {
      "optional": true
    }
  },
  "devDependencies": {
    "earcut": "3.2.3",
    "polygon-clipping": "^0.15.7"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/geom"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
