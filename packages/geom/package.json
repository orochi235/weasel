{
  "name": "@weasel-js/geom",
  "version": "1.19.1",
  "description": "Pure geometry kernel for @weasel-js/core: affine, box, curve, polyline, the Path command stream and its math, easing curves, and exact pen-order arc-length queries over 2D or 3D runs of lines and Bézier curves. Dependency-free core; curve representations in ./curves, tessellation in ./tessellate (earcut), polygon booleans and path splitting in ./booleans (polygon-clipping), vectors, quaternions, 4x4 matrices and ray intersection in ./3d, and dimension-generic snapping and a BVH (bounding volume hierarchy) for box, point, ray and half-space queries in ./nd.",
  "weasel": {
    "tier": "base"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./booleans": {
      "types": "./dist/booleans/index.d.ts",
      "import": "./dist/booleans/index.js"
    },
    "./3d": {
      "types": "./dist/3d/index.d.ts",
      "import": "./dist/3d/index.js"
    },
    "./nd": {
      "types": "./dist/nd/index.d.ts",
      "import": "./dist/nd/index.js"
    },
    "./curves": {
      "types": "./dist/curves/index.d.ts",
      "import": "./dist/curves/index.js"
    },
    "./tessellate": {
      "types": "./dist/tessellate/index.d.ts",
      "import": "./dist/tessellate/index.js"
    },
    "./warp": {
      "types": "./dist/warp/index.d.ts",
      "import": "./dist/warp/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "earcut": "3.2.4",
    "polygon-clipping": "^0.15.7"
  },
  "peerDependenciesMeta": {
    "earcut": {
      "optional": true
    },
    "polygon-clipping": {
      "optional": true
    }
  },
  "devDependencies": {
    "earcut": "3.2.4",
    "polygon-clipping": "^0.15.7"
  },
  "scripts": {
    "test": "node ../../scripts/package-test.mjs",
    "build": "tsup"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/geom"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
