{
  "name": "@weasel-js/diagram-formats",
  "version": "2.0.0",
  "description": "Converts @weasel-js/diagram scenes to and from files: an interchange document every format reads and writes, and its pages as an SVG document, a PNG image or a PDF.",
  "weasel": {
    "tier": "other"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/diagram-formats"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/geom": "2.0.0",
    "@weasel-js/paint": "2.0.0",
    "@weasel-js/pdf": "2.0.0",
    "@weasel-js/registry": "2.0.0"
  },
  "peerDependencies": {
    "@weasel-js/core": "2.0.0",
    "@weasel-js/diagram": "2.0.0",
    "@weasel-js/export": "2.0.0",
    "@weasel-js/plot": "2.0.0",
    "@weasel-js/svg": "2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@weasel-js/editing": "2.0.0",
    "@weasel-js/text-tools": "2.0.0"
  }
}
