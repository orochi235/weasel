{
  "name": "@orochi235/weasel-theme",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens shared by weasel-ui and weasel-hud — CSS variables + a parallel TS export.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./package.json": "./package.json"
  }
}
