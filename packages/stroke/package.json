{
  "name": "@weasel-js/stroke",
  "version": "2.0.0",
  "description": "A stroke as geometry: the ribbon mesh with joins, caps, dashes and per-vertex widths, the marker registry and its placed heads, and a stroke's outline as a path. No scene graph, no React.",
  "weasel": {
    "tier": "base"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-seams": {
      "types": "./dist/test-seams.d.ts",
      "import": "./dist/test-seams.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@weasel-js/geom": "2.0.0",
    "@weasel-js/paint": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "earcut": "3.2.4",
    "polygon-clipping": "^0.15.7"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/stroke"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node ../../scripts/package-test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
