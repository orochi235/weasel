{
  "name": "@weasel-js/rig",
  "version": "1.15.0",
  "description": "Rigging tools for a weasel canvas: the bone tool, which draws and edits a node's skeleton, and the weight tool, which paints how much each joint moves the paths under it.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./icons": {
      "import": "./dist/icons.table.js",
      "types": "./dist/icons.table.d.ts"
    },
    "./package.json": "./package.json"
  },
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/rig"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/icons.table.json dist/"
  },
  "dependencies": {
    "@weasel-js/animator": "1.15.0",
    "@weasel-js/history": "1.15.0",
    "@weasel-js/icons": "1.15.0",
    "@weasel-js/prefs": "1.15.0",
    "@weasel-js/react": "1.15.0",
    "@weasel-js/registry": "1.15.0",
    "@weasel-js/renderer": "1.15.0",
    "@weasel-js/routing": "1.15.0"
  },
  "peerDependencies": {
    "@weasel-js/core": "1.15.0",
    "@weasel-js/geom": "1.15.0",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
