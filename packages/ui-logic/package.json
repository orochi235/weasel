{
  "name": "@weasel-js/ui-logic",
  "version": "1.19.1",
  "description": "Headless components: the measure/draw contract, button, row-list, and menu-panel layout, and the focus scope that a DOM component and a canvas-drawn widget share. No React, no DOM.",
  "weasel": {
    "tier": "other"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/ui-logic"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/geom": "1.19.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
