{
  "name": "@weasel-js/diagram",
  "version": "2.0.0",
  "description": "Node-link diagramming for weasel: any scene node becomes a diagram participant, with ports on its perimeter and an optional body builder for flowchart-shaped boxes.",
  "weasel": {
    "tier": "plugin"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./effect-audio": {
      "types": "./dist/effect-audio.d.ts",
      "import": "./dist/effect-audio.js"
    },
    "./icons": {
      "types": "./dist/icons.table.d.ts",
      "import": "./dist/icons.table.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@weasel-js/animator": "2.0.0",
    "@weasel-js/audio": "2.0.0",
    "@weasel-js/core": "2.0.0",
    "@weasel-js/font": "2.0.0",
    "@weasel-js/geom": "2.0.0",
    "@weasel-js/react": "2.0.0",
    "@weasel-js/simulation": "2.0.0",
    "@weasel-js/text-tools": "2.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@weasel-js/audio": {
      "optional": true
    }
  },
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "dependencies": {
    "@weasel-js/clock": "2.0.0",
    "@weasel-js/editing": "2.0.0",
    "@weasel-js/icons": "2.0.0",
    "@weasel-js/prefs-schema": "2.0.0",
    "@weasel-js/quantity": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "@weasel-js/routing": "2.0.0",
    "@weasel-js/text": "2.0.0",
    "@weasel-js/ui-input": "2.0.0"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/diagram"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/icons.table.json dist/",
    "test": "node ../../scripts/package-test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
