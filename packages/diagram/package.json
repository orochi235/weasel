{
  "name": "@weasel-js/diagram",
  "version": "1.19.1",
  "description": "Node-link diagramming for weasel: any scene node becomes a diagram participant, with ports on its perimeter and an optional body builder for flowchart-shaped boxes.",
  "weasel": {
    "tier": "plugin"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./effect-audio": {
      "types": "./dist/effect-audio.d.ts",
      "import": "./dist/effect-audio.js"
    },
    "./icons": {
      "types": "./dist/icons.table.d.ts",
      "import": "./dist/icons.table.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@weasel-js/animator": "1.19.1",
    "@weasel-js/audio": "1.19.1",
    "@weasel-js/core": "1.19.1",
    "@weasel-js/font": "1.19.1",
    "@weasel-js/geom": "1.19.1",
    "@weasel-js/react": "1.19.1",
    "@weasel-js/simulation": "1.19.1",
    "@weasel-js/text-tools": "1.19.1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@weasel-js/audio": {
      "optional": true
    }
  },
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "dependencies": {
    "@weasel-js/clock": "1.19.1",
    "@weasel-js/editing": "1.19.1",
    "@weasel-js/icons": "1.19.1",
    "@weasel-js/prefs": "1.19.1",
    "@weasel-js/quantity": "1.19.1",
    "@weasel-js/registry": "1.19.1",
    "@weasel-js/routing": "1.19.1",
    "@weasel-js/text": "1.19.1",
    "@weasel-js/ui-input": "1.19.1"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/diagram"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/icons.table.json dist/",
    "test": "node ../../scripts/package-test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
