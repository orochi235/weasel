{
  "name": "@weasel-js/paint-kinds",
  "version": "1.19.1",
  "description": "The registry of paint kinds a weasel paint can be: solid, the gradients, the tile patterns, image, texture, mesh and any a consumer registers, each with its label, glyph, seed color, editor and SVG output, and the renderer's draw slots.",
  "weasel": {
    "tier": "base"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/mesh.ts",
    "./dist/mesh.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./mesh": {
      "types": "./dist/mesh.d.ts",
      "import": "./dist/mesh.js"
    },
    "./icons": {
      "types": "./dist/icons.table.d.ts",
      "import": "./dist/icons.table.js"
    },
    "./test-seams": {
      "types": "./dist/test-seams.d.ts",
      "import": "./dist/test-seams.js"
    },
    "./package.json": "./package.json"
  },
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/paint-kinds"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/icons.table.json dist/",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/icons": "1.19.1",
    "@weasel-js/paint": "1.19.1",
    "@weasel-js/registry": "1.19.1",
    "@weasel-js/renderer": "1.19.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
