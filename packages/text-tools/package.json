{
  "name": "@weasel-js/text-tools",
  "version": "2.0.0",
  "description": "Text for a weasel canvas, as presets an app opts into: the text node kind and its painter, the in-place editor, the text and sticky-note tools, and plain-text paste.",
  "weasel": {
    "tier": "plugin"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./package.json": "./package.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/text-tools"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/cursor": "2.0.0",
    "@weasel-js/editing": "2.0.0",
    "@weasel-js/font": "2.0.0",
    "@weasel-js/paint": "2.0.0",
    "@weasel-js/quantity": "2.0.0",
    "@weasel-js/react": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "@weasel-js/renderer": "2.0.0",
    "@weasel-js/routing": "2.0.0",
    "@weasel-js/text": "2.0.0",
    "@weasel-js/text-dom": "2.0.0",
    "polygon-clipping": "^0.15.7"
  },
  "peerDependencies": {
    "@weasel-js/core": "2.0.0",
    "@weasel-js/geom": "2.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@weasel-js/bidi": "2.0.0",
    "@weasel-js/icons": "2.0.0",
    "@weasel-js/path-tools": "2.0.0",
    "@weasel-js/prefs-schema": "2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
