{
  "name": "@weasel-js/editor",
  "version": "1.19.1",
  "description": "The frame and glue of a weasel editor app: a shell with the kit's providers, app-wide command keys, a menu bar, a topbar, and a preferences dialog; and autosave, session persistence, snapshot revival, file download and pick, pages, page fit, and the page's paper and grid.",
  "weasel": {
    "tier": "other"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@weasel-js/devtools": "1.19.1",
    "@weasel-js/editing": "1.19.1",
    "@weasel-js/registry": "1.19.1",
    "@weasel-js/storage": "1.19.1"
  },
  "peerDependencies": {
    "@weasel-js/core": "1.19.1",
    "@weasel-js/geom": "1.19.1",
    "@weasel-js/guides": "1.19.1",
    "@weasel-js/prefs": "1.19.1",
    "@weasel-js/text-tools": "1.19.1",
    "@weasel-js/ui": "1.19.1",
    "react": ">=18"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node ../../scripts/package-test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
