{
  "name": "@weasel-js/text-dom",
  "version": "2.0.0",
  "description": "In-place text editing over a canvas: a contenteditable overlay that reads and writes styled runs, with range styling, caret mapping and font-load handling. A React hook; no scene graph.",
  "weasel": {
    "tier": "other"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@weasel-js/font": "2.0.0",
    "@weasel-js/gestures": "2.0.0",
    "@weasel-js/paint": "2.0.0",
    "@weasel-js/react": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "@weasel-js/text": "2.0.0",
    "@weasel-js/ui-input": "2.0.0"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/text-dom"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node ../../scripts/package-test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
