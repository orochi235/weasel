    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./test-seams": {
      "import": "./dist/test-seams.js",
      "types": "./dist/test-seams.d.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@weasel-js/geom": "1.4.0",
    "@weasel-js/paint": "1.4.0"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/text"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@weasel-js/bidi": "1.4.0"
  },
  "peerDependencies": {
    "@weasel-js/font": "1.4.0"
  }
