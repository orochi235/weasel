{
  "name": "@weasel-js/hud",
  "version": "2.0.0",
  "description": "WebGL-rendered UI widgets that composite into a weasel canvas",
  "weasel": {
    "tier": "plugin",
    "needs": ["webgl2"]
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@weasel-js/core": "2.0.0",
    "@weasel-js/font": "2.0.0",
    "react": ">=18"
  },
  "dependencies": {
    "@weasel-js/geom": "2.0.0",
    "@weasel-js/gestures": "2.0.0",
    "@weasel-js/icons": "2.0.0",
    "@weasel-js/loupe": "2.0.0",
    "@weasel-js/menu": "2.0.0",
    "@weasel-js/paint": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "@weasel-js/routing": "2.0.0",
    "@weasel-js/text": "2.0.0",
    "@weasel-js/theme": "2.0.0",
    "@weasel-js/ui-input": "2.0.0",
    "@weasel-js/ui-logic": "2.0.0"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/hud"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node ../../scripts/package-test.mjs",
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.mjs dist"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@weasel-js/editing": "2.0.0"
  }
}
