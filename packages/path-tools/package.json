{
  "name": "@weasel-js/path-tools",
  "version": "2.0.0",
  "description": "Path-editing tools for a weasel canvas, as presets an app opts into: path edit and anchor editing, the pen, pencil and knife, path commands, Create Outlines, brushes, bridge, Snip and Reach, curvature, Poise, path constraints, Fillet, path effects, warps, and the Girth and Shape Builder tools.",
  "weasel": {
    "tier": "plugin"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./groups": {
      "types": "./dist/groups.d.ts",
      "import": "./dist/groups.js"
    },
    "./icons": {
      "types": "./dist/icons.table.d.ts",
      "import": "./dist/icons.table.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./package.json": "./package.json"
  },
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/path-tools"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/icons.table.json dist/",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/cursor": "2.0.0",
    "@weasel-js/editing": "2.0.0",
    "@weasel-js/icons": "2.0.0",
    "@weasel-js/modes": "2.0.0",
    "@weasel-js/paint": "2.0.0",
    "@weasel-js/prefs-schema": "2.0.0",
    "@weasel-js/react": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "@weasel-js/renderer": "2.0.0",
    "@weasel-js/routing": "2.0.0",
    "@weasel-js/stroke": "2.0.0",
    "@weasel-js/text": "2.0.0",
    "earcut": "3.2.4",
    "polygon-clipping": "^0.15.7"
  },
  "peerDependencies": {
    "@weasel-js/core": "2.0.0",
    "@weasel-js/geom": "2.0.0",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@weasel-js/text-tools": "2.0.0"
  }
}
