{
  "name": "@weasel-js/path-tools",
  "version": "1.13.0-rc.0",
  "description": "Path-editing tools for a weasel canvas, as presets an app opts into: brushes, bridge, trim and extend, curvature and handle balance, path constraints, corner shape, path effects, warps, and the Girth and Shape Builder tools.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./icons": {
      "import": "./dist/icons.table.js",
      "types": "./dist/icons.table.d.ts"
    },
    "./package.json": "./package.json"
  },
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/path-tools"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/icons.table.json dist/"
  },
  "dependencies": {
    "@weasel-js/cursor": "1.13.0-rc.0",
    "@weasel-js/icons": "1.13.0-rc.0",
    "@weasel-js/paint": "1.13.0-rc.0",
    "@weasel-js/prefs": "1.13.0-rc.0",
    "@weasel-js/react": "1.13.0-rc.0",
    "@weasel-js/registry": "1.13.0-rc.0",
    "@weasel-js/renderer": "1.13.0-rc.0",
    "@weasel-js/routing": "1.13.0-rc.0",
    "@weasel-js/stroke": "1.13.0-rc.0"
  },
  "peerDependencies": {
    "@weasel-js/core": "1.13.0-rc.0",
    "@weasel-js/geom": "1.13.0-rc.0",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
