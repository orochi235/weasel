{
  "name": "@weasel-js/ui",
  "version": "1.14.2",
  "description": "UI chrome primitives for weasel apps (properties panel, etc.)",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./icons": {
      "types": "./dist/icons.table.d.ts",
      "import": "./dist/icons.table.js"
    },
    "./kit-icons": {
      "types": "./dist/kitIcons.d.ts",
      "import": "./dist/kitIcons.js"
    },
    "./paint-value": {
      "types": "./dist/components/paintValue.d.ts",
      "import": "./dist/components/paintValue.js"
    },
    "./appearance": {
      "types": "./dist/components/appearance.d.ts",
      "import": "./dist/components/appearance.js"
    },
    "./portal-host": {
      "types": "./dist/overlays/portalHost.d.ts",
      "import": "./dist/overlays/portalHost.js"
    },
    "./color": {
      "types": "./dist/color/index.d.ts",
      "import": "./dist/color/index.js"
    },
    "./paint-gradient-track": {
      "types": "./dist/paintGradientTrack.d.ts",
      "import": "./dist/paintGradientTrack.js"
    },
    "./kit-settings": {
      "types": "./dist/kitSettings.d.ts",
      "import": "./dist/kitSettings.js"
    },
    "./floating": {
      "types": "./dist/floating/index.d.ts",
      "import": "./dist/floating/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "weaselIcons": {
    "table": "./dist/icons.table.json"
  },
  "dependencies": {
    "@weasel-js/clock": "1.14.2",
    "@weasel-js/font": "1.14.2",
    "@weasel-js/geom": "1.14.2",
    "@weasel-js/gestures": "1.14.2",
    "@weasel-js/headless": "1.14.2",
    "@weasel-js/icons": "1.14.2",
    "@weasel-js/menu": "1.14.2",
    "@weasel-js/modes": "1.14.2",
    "@weasel-js/paint": "1.14.2",
    "@weasel-js/plot": "1.14.2",
    "@weasel-js/prefs": "1.14.2",
    "@weasel-js/quantity": "1.14.2",
    "@weasel-js/react": "1.14.2",
    "@weasel-js/registry": "1.14.2",
    "@weasel-js/select": "1.14.2",
    "@weasel-js/svg": "1.14.2",
    "@weasel-js/text": "1.14.2",
    "@weasel-js/theme": "1.14.2",
    "prism-react-renderer": "^2.4.1",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "windease": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@weasel-js/animator": "1.14.2",
    "@weasel-js/core": "1.14.2"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cp src/icons.table.json dist/ && node ../labkit/scripts/build-css.mjs --if-built"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@weasel-js/bidi": "1.14.2",
    "@weasel-js/cursor": "1.14.2"
  }
}
