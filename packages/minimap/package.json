{
  "name": "@weasel-js/minimap",
  "version": "2.0.0",
  "description": "A minimap for a weasel canvas: a read-only overview with a viewport indicator you drag to pan and wheel or pinch to zoom, fit math, and a linked crosshair between surfaces.",
  "weasel": {
    "tier": "plugin"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/minimap"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/react": "2.0.0",
    "@weasel-js/routing": "2.0.0"
  },
  "peerDependencies": {
    "@weasel-js/animator": "2.0.0",
    "@weasel-js/core": "2.0.0",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
