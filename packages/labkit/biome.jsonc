{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!dist-examples",
      "!storybook-static",
      "!node_modules",
      "!examples",
      "!tsconfig.docs.json",
      "!docs/.vitepress/dist",
      "!docs/.vitepress/cache",
      // The repo writes tables unpadded; biome's formatter pads them, so one edit reflows a table.
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    // react is only a peerDependency here, and biome's domain auto-detection does not
    // read those — so the react rules, useExhaustiveDependencies above all, stayed off.
    "domains": { "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "style": {
        "noUnusedTemplateLiteral": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "overrides": [
    {
      // A test's harness component is defined once per test, so it never remounts the way
      // the rule guards against, and hoisting it would thread the test's locals through props.
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": { "rules": { "correctness": { "noComponentHookFactories": "off" } } }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
