{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    // NOTE: noUncheckedIndexedAccess is intentionally off for the build/dts
    // tsconfig because the bundled weasel-ui source (compiled here for type
    // emission) has latent index-access violations under it. Follow-up: fix the
    // 4 spots in packages/weasel-ui/src/useReorderDragList.ts and restore it.
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "scripts/**/*", ".storybook/**/*"]
}
