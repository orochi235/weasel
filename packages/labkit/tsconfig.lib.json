{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    // noUncheckedIndexedAccess is OFF. Enabling it strict-checks everything
    // labkit resolves to SOURCE — all of packages/ui (~360 violations) via the
    // @weasel-js/ui alias. Restoring the flag is a monorepo-wide hardening
    // initiative, not a labkit change.
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "scripts/**/*", ".storybook/**/*"]
}
