{
  "name": "@weasel-js/labkit",
  "version": "1.10.1",
  "description": "React widgets for building self-contained interactive lab pages",
  "weasel": {
    "needs": [
      "webgl2"
    ]
  },
  "license": "MIT",
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/labkit"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chrome": {
      "types": "./dist/chrome/index.d.ts",
      "import": "./dist/chrome/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas/index.js"
    },
    "./layers": {
      "types": "./dist/layers/index.d.ts",
      "import": "./dist/layers/index.js"
    },
    "./undo": {
      "types": "./dist/undo/index.d.ts",
      "import": "./dist/undo/index.js"
    },
    "./dragdrop": {
      "types": "./dist/dragdrop/index.d.ts",
      "import": "./dist/dragdrop/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./surface": {
      "types": "./dist/surface/index.d.ts",
      "import": "./dist/surface/index.js"
    },
    "./job": {
      "types": "./dist/job/index.d.ts",
      "import": "./dist/job/index.js"
    },
    "./overview": {
      "types": "./dist/overview/index.d.ts",
      "import": "./dist/overview/index.js"
    },
    "./weasel-ui": {
      "types": "./dist/passthrough/weasel-ui.d.ts",
      "import": "./dist/passthrough/weasel-ui.js"
    },
    "./weasel-canvas": {
      "types": "./dist/passthrough/weasel-canvas.d.ts",
      "import": "./dist/passthrough/weasel-canvas.js"
    },
    "./styles.css": "./dist/styles.css",
    "./loupe": {
      "types": "./dist/loupe/index.d.ts",
      "import": "./dist/loupe/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:drag": "LABKIT_EXAMPLE=drag-lab vite",
    "dev:weasel": "LABKIT_EXAMPLE=weasel-lab vite",
    "build": "tsup && npm run build:dts && npm run build:css && npm run build:fonts",
    "build:dts": "NODE_OPTIONS=--max-old-space-size=3072 tsx scripts/build-dts.mts",
    "prepublishOnly": "npm run build",
    "build:css": "node scripts/build-css.mjs",
    "build:fonts": "mkdir -p dist/fonts && cp ../theme/fonts/*.woff2 dist/fonts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke:consumer": "node scripts/smoke-consumer-bundle.mjs",
    "lint": "biome check . && tsx scripts/check-class-prefix.ts && tsx scripts/check-design-tokens.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev:schema": "LABKIT_EXAMPLE=schema-lab vite",
    "dev:annotate": "LABKIT_EXAMPLE=annotate-lab vite",
    "dev:3d": "LABKIT_EXAMPLE=3d-lab vite"
  },
  "peerDependencies": {
    "@weasel-js/animator": "1.10.1",
    "@weasel-js/core": "1.10.1",
    "@weasel-js/theme": "1.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@weasel-js/geom": "1.10.1",
    "@weasel-js/icons": "1.10.1",
    "@weasel-js/kernel3d": "1.10.1",
    "@weasel-js/loupe": "1.10.1",
    "@weasel-js/minimap": "1.10.1",
    "@weasel-js/prefs": "1.10.1",
    "@weasel-js/quantity": "1.10.1",
    "@weasel-js/react": "1.10.1",
    "@weasel-js/registry": "1.10.1",
    "@weasel-js/routing": "1.10.1",
    "@weasel-js/storage": "1.10.1",
    "@weasel-js/svg": "1.10.1",
    "@weasel-js/ui": "1.10.1",
    "earcut": "3.2.3",
    "polygon-clipping": "^0.15.7",
    "react-aria-components": "^1.5.0",
    "windease": "^2.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@msb235/blits": "0.10.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@weasel-js/guides": "1.10.1",
    "@weasel-js/history": "1.10.1",
    "@weasel-js/modes": "1.10.1",
    "less": "^4.2.0",
    "rollup-plugin-dts": "^6.4.1",
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
