{
  "name": "@weasel-js/labkit",
  "version": "0.7.1",
  "description": "React widgets for building self-contained interactive lab pages",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas/index.js"
    },
    "./layers": {
      "types": "./dist/layers/index.d.ts",
      "import": "./dist/layers/index.js"
    },
    "./undo": {
      "types": "./dist/undo/index.d.ts",
      "import": "./dist/undo/index.js"
    },
    "./dragdrop": {
      "types": "./dist/dragdrop/index.d.ts",
      "import": "./dist/dragdrop/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./weasel-ui": {
      "types": "./dist/passthrough/weasel-ui.d.ts",
      "import": "./dist/passthrough/weasel-ui.js"
    },
    "./weasel-canvas": {
      "types": "./dist/passthrough/weasel-canvas.d.ts",
      "import": "./dist/passthrough/weasel-canvas.js"
    },
    "./ui/layers": {
      "types": "./dist/ui/layers/index.d.ts",
      "import": "./dist/ui/layers/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme-light.css": "./dist/theme-light.css",
    "./theme-interstellar.css": "./dist/theme-interstellar.css"
  },
  "scripts": {
    "dev": "vite",
    "dev:drag": "LABKIT_EXAMPLE=drag-lab vite",
    "dev:weasel": "LABKIT_EXAMPLE=weasel-lab vite",
    "build": "tsup && npm run build:dts && npm run build:css && npm run build:fonts",
    "build:dts": "tsx scripts/build-dts.mts",
    "prepublishOnly": "npm run build",
    "build:css": "lessc src/styles.less dist/styles.css && lessc src/theme/light.less dist/theme-light.css && lessc src/theme/interstellar.less dist/theme-interstellar.css",
    "build:fonts": "mkdir -p dist/fonts && cp src/fonts/*.woff2 dist/fonts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke:consumer": "node scripts/smoke-consumer-bundle.mjs",
    "lint": "biome check . && tsx scripts/check-class-prefix.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "earcut": "2.2.4",
    "polygon-clipping": "^0.15.7",
    "react-aria-components": "^1.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@rollup/plugin-alias": "^6.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@weasel-js/modes": "*",
    "@weasel-js/ui": "*",
    "less": "^4.2.0",
    "rollup-plugin-dts": "^6.4.1",
    "tsx": "^4.19.0",
    "vitepress": "^1.6.4"
  }
}
