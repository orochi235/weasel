{
  "name": "@weasel-js/export",
  "version": "1.19.1",
  "description": "Exports regions of a @weasel-js/core scene: a page, a selection or any rect, as PNG or any format another package registers (SVG, PDF), with a diagnostics report and a retry when the scene changes mid-export.",
  "weasel": {
    "tier": "plugin"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/export"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/geom": "1.19.1",
    "@weasel-js/registry": "1.19.1",
    "@weasel-js/renderer": "1.19.1"
  },
  "peerDependencies": {
    "@weasel-js/core": "1.19.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
