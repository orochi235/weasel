{
  "name": "@weasel-js/prefs-editor",
  "version": "1.19.1",
  "description": "An editor for preferences schemas: build a schema's sections, fields, conditions, and kinds by hand, preview the form it draws, and export it.",
  "weasel": {
    "tier": "other"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/prefs-editor"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/gestures": "1.19.1",
    "@weasel-js/icons": "1.19.1",
    "@weasel-js/prefs": "1.19.1",
    "@weasel-js/quantity": "1.19.1",
    "@weasel-js/react": "1.19.1",
    "@weasel-js/registry": "1.19.1",
    "@weasel-js/ui": "1.19.1",
    "@weasel-js/ui-input": "1.19.1",
    "react-aria-components": "1.22.1"
  },
  "peerDependencies": {
    "@weasel-js/core": "1.19.1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
