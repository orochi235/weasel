{
  "name": "@weasel-js/forge",
  "version": "1.18.2",
  "description": "A component workshop on labkit: stories in isolated frames, controls and state in lab trials.",
  "weasel": {
    "tier": "other"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./frame": {
      "types": "./dist/frame/index.d.ts",
      "import": "./dist/frame/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./preview-api": {
      "types": "./dist/csf/preview-api.d.ts",
      "import": "./dist/csf/preview-api.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "import": "./dist/test/index.js"
    },
    "./play": {
      "types": "./dist/test/play.d.ts",
      "import": "./dist/test/play.js"
    },
    "./shell.css": "./dist/shell/index.css",
    "./frame.css": "./dist/frame/index.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "weaselforge": "dist/cli.js"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/forge"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@babel/parser": "^8.0.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/expect": "^5.0.2",
    "@weasel-js/clock": "1.18.2",
    "@weasel-js/icons": "1.18.2",
    "@weasel-js/prefs": "1.18.2",
    "@weasel-js/react": "1.18.2",
    "@weasel-js/registry": "1.18.2",
    "@weasel-js/svg": "1.18.2",
    "@weasel-js/theme": "1.18.2",
    "@weasel-js/ui": "1.18.2",
    "axe-core": "^4.13.0",
    "chai": "^6.2.2",
    "typescript": "~6.0.2"
  },
  "devDependencies": {
    "@babel/types": "^8.0.6"
  },
  "peerDependencies": {
    "@weasel-js/core": "1.18.2",
    "@weasel-js/labkit": "1.18.2",
    "react": "^19.0.0",
    "playwright": "^1.50.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
