{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "../../tsconfig.json",
  "out": "../../dist-demo/api-prefs",
  "name": "@weasel-js/prefs",
  "includeVersion": false,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "exclude": ["**/*.test.ts", "**/*.test.tsx"],
  "readme": "README.md",
  "skipErrorChecking": true,
  // Quantity has no doc site of its own; core's re-exports document it.
  "externalSymbolLinkMappings": {
    "@weasel-js/quantity": {
      "UnitSystem": "../api/interfaces/UnitSystem.html"
    }
  },
  // `PrefPath`'s string-joining step, not a type a consumer names.
  "intentionallyNotExported": ["Join"]
}
