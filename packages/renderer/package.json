{
  "name": "@weasel-js/renderer",
  "version": "1.19.1",
  "description": "A WebGL 2 or WebGPU renderer for draw commands: batched path fills and strokes, MSDF and outline text, images and sprites, gradients, patterns, registered shader programs, and full-screen effects. No scene graph, no React.",
  "weasel": {
    "tier": "base",
    "needs": ["webgl2"]
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mesh": {
      "types": "./dist/mesh.d.ts",
      "import": "./dist/mesh.js"
    },
    "./patterns-builtin": {
      "types": "./dist/patterns-builtin.d.ts",
      "import": "./dist/patterns-builtin.js"
    },
    "./testing/glRecorder": {
      "types": "./dist/testing/glRecorder.d.ts",
      "import": "./dist/testing/glRecorder.js"
    },
    "./testing/vertexUploads": {
      "types": "./dist/testing/vertexUploads.d.ts",
      "import": "./dist/testing/vertexUploads.js"
    },
    "./test-seams": {
      "types": "./dist/test-seams.d.ts",
      "import": "./dist/test-seams.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@weasel-js/geom": "1.19.1",
    "@weasel-js/paint": "1.19.1",
    "@weasel-js/registry": "1.19.1",
    "@weasel-js/stroke": "1.19.1",
    "@weasel-js/text": "1.19.1"
  },
  "peerDependencies": {
    "@weasel-js/font": "1.19.1"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/renderer"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node ../../scripts/package-test.mjs",
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
