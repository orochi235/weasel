{
  "name": "@weasel-js/svg",
  "version": "2.0.0",
  "description": "SVG import/export for @weasel-js/core: parse SVG strings into weasel-native shapes and serialize them back.",
  "weasel": {
    "tier": "other"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node ../../scripts/package-test.mjs",
    "build": "tsup"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/svg"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@weasel-js/font": "2.0.0",
    "@weasel-js/geom": "2.0.0",
    "@weasel-js/paint": "2.0.0",
    "@weasel-js/paint-kinds": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "@weasel-js/stroke": "2.0.0",
    "@weasel-js/text": "2.0.0"
  },
  "peerDependencies": {
    "@weasel-js/core": "2.0.0",
    "@weasel-js/export": "2.0.0",
    "@weasel-js/text-tools": "2.0.0"
  }
}
