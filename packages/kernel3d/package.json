{
  "name": "@weasel-js/kernel3d",
  "version": "1.19.1",
  "description": "3D kernel for weasel: poses, orbit camera, ray picking, screen-projected chrome geometry and a screen-space line pass over core's scene graph and dispatcher. Hosts a renderer rather than owning one.",
  "weasel": {
    "tier": "other"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "author": "orochi235",
  "homepage": "https://orochi235.github.io/weasel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/weasel.git",
    "directory": "packages/kernel3d"
  },
  "bugs": {
    "url": "https://github.com/orochi235/weasel/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node ../../scripts/package-test.mjs"
  },
  "dependencies": {
    "@weasel-js/geom": "1.19.1",
    "@weasel-js/paint": "1.19.1",
    "@weasel-js/prefs": "1.19.1",
    "@weasel-js/react": "1.19.1",
    "@weasel-js/routing": "1.19.1",
    "@weasel-js/stroke": "1.19.1"
  },
  "peerDependencies": {
    "@weasel-js/core": "1.19.1",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
