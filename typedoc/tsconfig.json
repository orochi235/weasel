{
  // The root config's options and path mappings, for a program over one package's
  // sources: `docsTsconfig` writes the config that extends this with that package's `src`.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node"]
  },
  "exclude": ["../node_modules", "../**/dist", "../**/*.test.ts", "../**/*.test.tsx", "../**/*.stories.tsx"]
}
